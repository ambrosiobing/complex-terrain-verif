# credentials
.env
*.secret

# caches and heavy data
data/cache/*
!data/cache/.gitkeep
data/fixtures/*
!data/fixtures/.gitkeep
!data/fixtures/README.md
*.grib
*.grib2
*.index
*.ckpt
*.pt

# results are regenerated; keep the small committed tables only
results/*.png
results/*.svg
results/figures/
results/fixtures/
results/*/figures/

# the commit message is written to a file, because PowerShell 5.1 has no usable
# heredoc and `git commit -F` is the way in. It is scratch, never a tracked file.
commit-message.txt

# python
.venv/
.pixi/
.ruff_cache/
__pycache__/
*.pyc
*.egg-info/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/
