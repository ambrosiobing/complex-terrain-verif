# Copy to .env (which is gitignored) and fill in.
# Frost client id: request one with an email address at https://frost.met.no/auth/requestCredentials.html
FROST_CLIENT_ID=
# Descriptive User-Agent with a contact, required by api.met.no terms of service
AFV_USER_AGENT=aifs-frost-verif/0.1 github.com/ambrosiobing/aifs-frost-verif
